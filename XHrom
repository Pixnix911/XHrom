    function extEnabled(n) {
        const v = localStorage.getItem('korone_ext_' + n);
        return v === null ? true : v === 'true';
    }
    function extSet(n, val) {
        localStorage.setItem('korone_ext_' + n, String(val));
    }

    // ============================================================
    // Whitelist / Blacklist (хранилище)
    // ============================================================
    const STORAGE_BLACKLIST = 'frooexp_blacklist';
    const STORAGE_WHITELIST = 'frooexp_whitelist';
    let blacklist = new Set();
    let whitelist = new Set();

    function loadLists() {
        try {
            const bl = JSON.parse(GM_getValue(STORAGE_BLACKLIST, '[]'));
            blacklist = new Set(bl);
            const wl = JSON.parse(GM_getValue(STORAGE_WHITELIST, '[]'));
            whitelist = new Set(wl);
        } catch(e) { console.error(e); }
    }
    function saveLists() {
        GM_setValue(STORAGE_BLACKLIST, JSON.stringify([...blacklist]));
        GM_setValue(STORAGE_WHITELIST, JSON.stringify([...whitelist]));
    }
    function isBlacklisted(uid) { return blacklist.has(String(uid)); }
    function isWhitelisted(uid) { return whitelist.has(String(uid)); }
    function addBlacklist(uid) { blacklist.add(String(uid)); saveLists(); }
    function removeBlacklist(uid) { blacklist.delete(String(uid)); saveLists(); }
    function addWhitelist(uid) { whitelist.add(String(uid)); saveLists(); }
    function removeWhitelist(uid) { whitelist.delete(String(uid)); saveLists(); }
    loadLists();

