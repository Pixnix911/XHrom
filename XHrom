                        const fields = doc.fields;
                        return {
                            id: doc.name.split('/').pop(),
                            userId: fields.userId?.stringValue || '',
                            userName: fields.userName?.stringValue || 'Unknown',
                            userAvatar: fields.userAvatar?.stringValue || '',
                            text: fields.text?.stringValue || '',
                            timestamp: fields.timestamp?.timestampValue || new Date().toISOString()
                        };
                    });
                    messages.sort(function(a, b) { return new Date(a.timestamp) - new Date(b.timestamp); });
