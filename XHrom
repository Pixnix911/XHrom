            function statsHtml() { const all = getData(), bannedN = all.filter(function(u) { return isBanned(u); }).length, total = filtered().length; let s = '<span>Total: ' + all.length + '</span>'; if (currentSearch) s += '<span>Showing: ' + total + '</span>'; if (bannedN > 0) s += '<span class="st-red">Banned: ' + bannedN + '</span>'; if (selectedIds.size > 0) s += '<span class="st-blue">Selected: ' + selectedIds.size + '</span>'; return s; }

