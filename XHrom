                try {
                    const response = await fetch('https://koromons.xyz/api/items/' + assetId);
                    if (response.ok) {
                        const data = await response.json();
                        if (data.weeklyAverage) return data.weeklyAverage;
                        if (data.averagePrice) return data.averagePrice;
                    }
                    const rapResp = await fetch('https://pekora.pro/apisite/economy/v1/assets/' + assetId + '/details');
                    if (rapResp.ok) {
                        const details = await rapResp.json();
                        return details.recentAveragePrice || details.price || 0;
                    }
                    return null;
                } catch(e) { return null; }
            }

            async function injectDiscount() {
                const match = location.pathname.match(/\/catalog\/(\d+)/);
                if (!match) return;
                const assetId = match[1];
                const priceEl = document.querySelector('[class*="priceLabel"], .priceLabel-0-2-61, [class*="price"]');
                if (!priceEl) return;
                if (document.getElementById('pd-discount')) return;
                const priceText = priceEl.textContent.trim();
                const currentPrice = parseInt(priceText.replace(/[^\d]/g, ''), 10);
                if (isNaN(currentPrice) || currentPrice === 0) return;
                const avgPrice = await fetchWeeklyAverage(assetId);
                if (!avgPrice || avgPrice === 0) return;
                const diff = currentPrice - avgPrice;
                const percent = ((diff / avgPrice) * 100).toFixed(1);
                const isDiscount = diff < 0;
                const discountSpan = document.createElement('div');
                discountSpan.id = 'pd-discount';
                discountSpan.style.cssText = 'font-size:13px;margin-top:4px;color:' + (isDiscount ? '#4ade80' : '#f87171') + ';font-weight:500;background:rgba(0,0,0,0.05);display:inline-block;padding:2px 8px;border-radius:16px;';
                discountSpan.textContent = isDiscount ? '📉 ' + Math.abs(percent) + '% below weekly avg (' + avgPrice.toLocaleString() + ' R$)' : '📈 +' + percent + '% above weekly avg (' + avgPrice.toLocaleString() + ' R$)';
                priceEl.parentElement.insertBefore(discountSpan, priceEl.nextSibling);
            }

            setTimeout(injectDiscount, 1000);
            const observer = new MutationObserver(function() { if (!document.getElementById('pd-discount')) injectDiscount(); });
            observer.observe(document.body, { childList: true, subtree: true });
        })();
    }

