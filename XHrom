                });
                window.addEventListener('mousemove', function(e) {
                    if (!isDragging) return;
                    let left = e.clientX - offsetX;
                    let top = e.clientY - offsetY;
                    left = Math.min(Math.max(left, 10), window.innerWidth - win.offsetWidth - 10);
