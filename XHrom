                root.querySelectorAll('.pk-uf-btn').forEach(function(btn) { btn.addEventListener('click', async function() { const uid = parseInt(this.dataset.uid, 10), u = allFriendsData.find(function(x) { return x.id === uid; }); if (!confirm('Unfriend ' + (u?.name || uid) + '?')) return; this.disabled = true; this.textContent = '...'; const r = await postApi(BASE + '/v1/users/' + uid + '/unfriend'); if (r.ok) { allFriendsData = allFriendsData.filter(function(x) { return x.id !== uid; }); selectedIds.delete(uid); const card = this.closest('.pk-card'); if (card) { card.style.opacity = '0'; card.style.transform = 'scale(0.95)'; } setTimeout(function() { render(); }, 250); } else { this.textContent = 'Error'; setTimeout(function() { this.textContent = 'Unfriend'; this.disabled = false; }.bind(this), 2000); } }); });
